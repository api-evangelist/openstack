{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenStack Identity (Keystone) API v3 Domains Groups API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{keystone-host}:5000/v3/groups"
          },
          "docs": "List groups"
        },
        {
          "info": {
            "name": "Create group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{keystone-host}:5000/v3/groups",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create group"
        }
      ]
    }
  ],
  "bundled": true
}