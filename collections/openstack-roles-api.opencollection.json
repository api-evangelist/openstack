{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenStack Identity (Keystone) API v3 Domains Roles API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{keystone-host}:5000/v3/roles"
          },
          "docs": "List roles"
        },
        {
          "info": {
            "name": "Create role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{keystone-host}:5000/v3/roles",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create role"
        },
        {
          "info": {
            "name": "List role assignments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{keystone-host}:5000/v3/role_assignments",
            "params": [
              {
                "name": "scope.project.id",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope.domain.id",
                "value": "",
                "type": "query"
              },
              {
                "name": "user.id",
                "value": "",
                "type": "query"
              },
              {
                "name": "group.id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List role assignments"
        }
      ]
    }
  ],
  "bundled": true
}