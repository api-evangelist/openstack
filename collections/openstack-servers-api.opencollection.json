{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenStack Identity (Keystone) API v3 Domains Servers API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Servers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{keystone-host}:5000/v3/servers"
          },
          "docs": "List servers"
        },
        {
          "info": {
            "name": "Create server",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{keystone-host}:5000/v3/servers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create server"
        },
        {
          "info": {
            "name": "List servers (detailed)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{keystone-host}:5000/v3/servers/detail"
          },
          "docs": "List servers (detailed)"
        },
        {
          "info": {
            "name": "Get server",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{keystone-host}:5000/v3/servers/:server_id",
            "params": [
              {
                "name": "server_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get server"
        },
        {
          "info": {
            "name": "Update server",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{keystone-host}:5000/v3/servers/:server_id",
            "params": [
              {
                "name": "server_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update server"
        },
        {
          "info": {
            "name": "Delete server",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{keystone-host}:5000/v3/servers/:server_id",
            "params": [
              {
                "name": "server_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete server"
        }
      ]
    }
  ],
  "bundled": true
}